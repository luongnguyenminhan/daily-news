POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=daily_news

# used by the api container
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/daily_news?schema=public

# optional — raises GitHub search's rate limit from 10/min to 30/min.
# create a token with no scopes at https://github.com/settings/tokens
GITHUB_TOKEN=
